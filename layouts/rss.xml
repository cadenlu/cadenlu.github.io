{{- /* Custom RSS feed. Differs from Hugo's embedded template in two ways:
       `unlisted` pages are excluded, and only regular pages are listed. */ -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ with site.Title }}{{ . }}: {{ end }}{{ .Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ if .IsHome }}{{ site.Params.description | default (printf "Recent content on %s" site.Title) }}{{ else }}Recent content on {{ site.Title }}{{ with .Description }}: {{ . }}{{ end }}{{ end }}</description>
    <generator>Hugo {{ hugo.Version }}</generator>
    <language>{{ site.Language.Lang }}</language>
    {{- with site.Copyright }}
    <copyright>{{ . | transform.XMLEscape | safeHTML }}</copyright>
    {{- end }}
    {{- with site.Home.OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- /* Home owns no regular pages directly, so fall back to the whole site. */ -}}
    {{- $base := cond .IsHome site.RegularPages .RegularPages }}
    {{- $all := where $base.ByDate.Reverse "Params.unlisted" "!=" true }}
    {{- $limit := site.Config.Services.RSS.Limit | default 0 }}
    {{- $pages := cond (gt $limit 0) (first $limit $all) $all }}
    {{- with $pages }}
    <lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- else }}
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title | transform.XMLEscape | safeHTML }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ with .Description }}{{ . | transform.XMLEscape | safeHTML }}{{ else }}{{ .Summary | plainify | transform.XMLEscape | safeHTML }}{{ end }}</description>
      {{- range .Params.tags }}
      <category>{{ . | transform.XMLEscape | safeHTML }}</category>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
